# 工作区级环境变量模板
# 用法：cp .env.example .env 然后填入真实值。.env 已被 git 忽略。
# 各子项目若有自己的 .env（如 gridbot），按该项目的 .env.example 单独配置。

# ---------- 记忆系统（Mem0）----------
# 必填：用于事实抽取 + 中文查询翻译。没有它记忆仍会写入账本，但不会建索引。
DEEPSEEK_API_KEY=sk-your-deepseek-key

# ---------- A 股数据 ----------
# a-stock-data / a-stock-strategy 可选
TUSHARE_TOKEN=
# 指到带 qlib 的 Python 解释器（可选）
A_STOCK_QLIB_PYTHON=

# ---------- Android 签名 ----------
# 不放这里。签名参数放各 Android 项目的 key.properties（已被 git 忽略）：
#   storeFile=mira.keystore
#   storePassword=...
#   keyAlias=mira
#   keyPassword=...
