# ============================================================
# 工作区根 ignore 规则
# 原则：只跟踪"人写的、需要 review 的、重建代价高"的东西。
#       依赖、构建产物、发布包、密钥、本机状态一律不入库。
# ============================================================

# ---------- 操作系统 / IDE ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
.codeflicker/
*.swp
*.swo
.classpath
.project
.settings/

# ---------- 密钥 / 环境 ----------
.env
.env.*
!.env.example
*.keystore
*.jks
*.p12
key.properties

# ---------- 依赖与构建产物 ----------
node_modules/
dist/
build/
out/
target/
.gradle/
.dart_tool/
.pub-cache/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
coverage/
*.class

# ---------- 发布产物（走 GitHub Releases，不进 git）----------
*.apk
*.aab
*.ipa
*.dmg

# ---------- 工作区自身状态 ----------
.worktrees/
.superpowers/brainstorm/
.memory/qdrant/
.memory/history.db
.memory/.cache/

